APP_NAME=Clove API
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./recruitment.db
DEV_USER_ID=demo-user
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional PostgreSQL production database:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clove

# Optional Milvus. The app falls back to deterministic local cosine search.
MILVUS_ENABLED=false
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=candidate_embeddings
EMBEDDING_DIMENSIONS=96
EMBEDDING_PROVIDER=local_feature_hash
EMBEDDING_MODEL=feature-hash-v1

# Reserved for the production adapters. Adding values does not enable a live
# OAuth, calendar, or Stripe flow in the current MVP.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
