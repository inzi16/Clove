# Optional overrides for the local Compose stack. The defaults are safe only
# for development on your own machine; do not reuse them in a shared environment.

# Application
APP_ENV=development
API_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
DEV_USER_ID=demo-user
SEED_DEMO_DATA=true

# PostgreSQL
POSTGRES_DB=clove
POSTGRES_USER=clove
POSTGRES_PASSWORD=clove_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://clove:clove_local@localhost:5432/clove

# Milvus. etcd and MinIO below are support services for Milvus, not resume storage.
MILVUS_ENABLED=true
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=candidate_embeddings
MILVUS_PORT=19530
MILVUS_WEB_PORT=9091
EMBEDDING_PROVIDER=local_feature_hash
EMBEDDING_MODEL=feature-hash-v1
EMBEDDING_DIMENSIONS=96

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Reserved production adapter settings. The MVP loads these values but does not
# expose live OAuth, calendar, or Stripe flows yet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Infrastructure images tested by the local stack.
POSTGRES_IMAGE=postgres:16-alpine
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.25
MINIO_IMAGE=minio/minio:RELEASE.2024-12-18T13-15-44Z
MILVUS_IMAGE=milvusdb/milvus:v2.6.21
